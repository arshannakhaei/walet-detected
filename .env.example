# Copy to .env and fill in what you have. Everything is optional.

# Free key from https://www.trongrid.io — raises Tron rate limits.
TRONGRID_API_KEY=

HOST=127.0.0.1
PORT=8000

# How many transfers to download per address (higher = slower, more complete).
MAX_TRANSFERS_PER_ADDRESS=2000
# Seconds before cached address data is fetched again.
CACHE_TTL_SECONDS=300
