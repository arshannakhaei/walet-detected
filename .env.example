# Copy to .env and fill in what you have. Everything is optional: without
# keys the free public endpoints are used (slower, lower limits).

HOST=127.0.0.1
# If the port is taken, the app moves to the next free one automatically.
PORT=8765

# Keys can also be entered in the dashboard (Settings page); they are saved here.

# --- Tron: free key from https://www.trongrid.io — without it TronGrid allows only
# 1 request/second and busy wallets fail with HTTP 429; with it ~15/second.
TRONGRID_API_KEY=

# --- EVM chains: one free key from https://etherscan.io/apis covers
# Ethereum, BSC, Polygon, Arbitrum, Optimism, Base and Avalanche (Etherscan V2).
# Without it, Ethereum/Polygon/Arbitrum/Optimism/Base use Blockscout and
# BSC/Avalanche are disabled.
ETHERSCAN_API_KEY=

# --- Bitcoin (Esplora API): mempool.space or https://blockstream.info/api
BITCOIN_API_URL=https://mempool.space/api

# --- Solana RPC: the public endpoint is slow; a free Helius/QuickNode URL is better
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAX_TRANSACTIONS=300

# --- USD prices (optional demo key from coingecko.com)
COINGECKO_API_KEY=

# Toman per US dollar. Empty = live USDT/toman market rate (Nobitex, then Wallex).
# Set it when those sites are unreachable (e.g. outside Iran / with a VPN) or to fix the rate for a report.
USD_TOMAN_RATE=

# --- Alchemy (optional): faster RPC for the free Chainalysis sanctions oracle on EVM chains
ALCHEMY_API_KEY=

# How many transfers to download per address (higher = slower, more complete).
MAX_TRANSFERS_PER_ADDRESS=1000
# Seconds before cached address data is fetched again.
CACHE_TTL_SECONDS=300
# Addresses with more transfers than this are treated as hubs (exchanges,
# services) and not expanded in graphs and traces.
HUB_THRESHOLD=500

# --- Watchlist: seconds between checks of watched addresses (0 = off)
MONITOR_INTERVAL_SECONDS=120

# --- Telegram bot (optional). Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Send /start to the
# bot and it replies with your id.
TELEGRAM_ALLOWED_USERS=
# Where the dashboard is reachable, for links in bot messages (e.g. http://192.168.1.10:8765)
PUBLIC_URL=

# --- Offline demo: Tron serves a built-in synthetic scam scenario (no internet needed)
DEMO_MODE=false
